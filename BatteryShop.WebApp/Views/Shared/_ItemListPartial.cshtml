@model BatteryShop.DataAccess.ViewModels.ItemViewModel

<input type="hidden" id="TotalRows" value="@Model.TotalRows" />

<div class="items-rows-container">
    <div class="item-row item-row-header">
        <div class="item-cell cell-id sortable" data-column="itemId">
            ID <span class="sort-icon"></span>
        </div>
        <div class="item-cell cell-brand">Brand</div>
        <div class="item-cell cell-model">Model</div>
        <div class="item-cell cell-serial sortable" data-column="itemSerialNumber">
            Serial <span class="sort-icon"></span>
        </div>
        <div class="item-cell cell-status">Status</div>
        <div class="item-cell cell-actions"></div>
    </div>

    @if (Model.ItemList.Count > 0)
    {
        foreach (var item in Model.ItemList)
        {
            <div class="item-row item-row-data">
                <div class="item-cell cell-id">@item.ItemId</div>
                <div class="item-cell cell-brand">@item.ItemBrand</div>
                <div class="item-cell cell-model">@item.ItemType</div>
                <div class="item-cell cell-serial">@item.ItemSerialNumber</div>
                <div class="item-cell cell-status">
                    <span class="badge bg-@(item.ItemStatusName == "In Stock" ? "success" : item.ItemStatusName == "Sold" ? "secondary" : item.ItemStatusName == "Replacement Given" ? "info" : item.ItemStatusName == "Damaged" ? "danger" : "warning")">
                        @item.ItemStatusName
                    </span>
                </div>
                <div class="item-cell cell-actions">
                    <button class="btn btn-sm btn-info btn-action-view" data-id="@item.ItemId" title="View Details">
                        <i class="bi bi-eye"></i>
                    </button>
                    <button class="btn btn-sm btn-primary btn-action-update" data-id="@item.ItemId" title="Update">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-danger btn-action-delete" data-id="@item.ItemId" title="Delete">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning text-center mt-4">
            <i class="bi bi-info-circle"></i> No Records Found
        </div>
    }
</div>