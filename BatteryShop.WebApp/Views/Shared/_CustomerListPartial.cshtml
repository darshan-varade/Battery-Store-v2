@model BatteryShop.DataAccess.ViewModels.CustomerViewModel

<input type="hidden" id="TotalRows" value="@Model.TotalRows" />

<div class="items-rows-container">
    <div class="item-row item-row-header">
        <div class="item-cell cell-user-id sortable" data-column="userId">
            ID <span class="sort-icon"></span>
        </div>
        <div class="item-cell cell-name">Name</div>
        <div class="item-cell cell-phone">Phone</div>
        <div class="item-cell cell-city">City</div>
        <div class="item-cell cell-balance sortable" data-column="userBalance">
            Balance <span class="sort-icon"></span>
        </div>
        <div class="item-cell cell-actions"></div>
    </div>

    @if (Model.CustomerList.Count > 0)
    {
        foreach (var item in Model.CustomerList)
        {
            <div class="item-row item-row-data">
                <div class="item-cell cell-user-id">@item.UserId</div>
                <div class="item-cell cell-name">@item.UserFullName</div>
                <div class="item-cell cell-phone">@item.UserPhone</div>
                <div class="item-cell cell-city">@item.UserCity</div>
                <div class="item-cell cell-balance">
                    <span class="badge @(item.UserBalance > 0 ? "bg-warning text-dark" : "bg-success")">
                        @item.UserBalance.ToString("N2")
                    </span>
                </div>
                <div class="item-cell cell-actions">
                    <button class="btn btn-sm btn-info btn-action-view" data-id="@item.UserId" title="View Details">
                        <i class="bi bi-eye"></i>
                    </button>
                    <button class="btn btn-sm btn-primary btn-action-update" data-id="@item.UserId" title="Update">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-danger btn-action-delete" data-id="@item.UserId" title="Delete">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning text-center mt-4">
            <i class="bi bi-info-circle"></i> No Records Found
        </div>
    }
</div>
