@model BatteryShop.DataAccess.ViewModels.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Battery Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .auth-card {
            background: #fff;
            border-radius: 16px;
            padding: 40px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }
        .auth-card .logo {
            text-align: center;
            margin-bottom: 32px;
        }
        .auth-card .logo i {
            font-size: 2.5rem;
            color: #2563eb;
        }
        .auth-card .logo h2 {
            font-size: 1.5rem;
            font-weight: 700;
            margin-top: 8px;
            color: #1e293b;
        }
        .auth-card .form-label {
            font-weight: 600;
            font-size: 0.85rem;
            color: #475569;
        }
        .auth-card .btn-primary {
            background-color: #2563eb;
            border-color: #2563eb;
            padding: 10px;
            font-weight: 600;
        }
        .auth-card .btn-primary:hover {
            background-color: #1d4ed8;
        }
        .auth-footer {
            text-align: center;
            margin-top: 20px;
            font-size: 0.9rem;
            color: #64748b;
        }
        .validation-summary-errors {
            color: #dc2626;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="logo">
            <i class="bi bi-lightning-charge"></i>
            <h2>Battery Store</h2>
            <p class="text-secondary" style="font-size: 0.9rem;">Sign in to your account</p>
        </div>

        @using (Html.BeginForm("Login", "Auth", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors mb-3" })

            <div class="mb-3">
                @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Enter your email" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger", style = "font-size: 0.8rem;" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter your password" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger", style = "font-size: 0.8rem;" })
            </div>

            <button type="submit" class="btn btn-primary w-100">Sign In</button>
        }

        <div class="auth-footer">
            Don't have an account? <a href="@Url.Action("Signup", "Auth")">Sign up</a>
        </div>
    </div>
</body>
</html>
