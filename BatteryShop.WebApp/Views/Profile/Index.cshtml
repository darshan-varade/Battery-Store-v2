@model BatteryShop.DataAccess.ViewModels.OwnerProfileViewModel
@{
    ViewBag.Title = "My Profile";
}

<div class="profile-container" data-remove-url="@Url.Action("RemovePhoto", "Profile")">
    <div class="profile-card">
        <div class="profile-card-header">
            <h4><i class="bi bi-person-gear"></i>My Profile</h4>
        </div>
        <div class="profile-card-body">
            @using (Html.BeginForm("Index", "Profile", FormMethod.Post, new { enctype = "multipart/form-data", @class = "profile-form" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.OwnerId)
                @Html.HiddenFor(m => m.ProfileImage, new { id = "profileImageHidden" })

                <div class="profile-avatar-section">
                    <div id="avatarPreview">
                        @if (!string.IsNullOrEmpty(Model.ProfileImage))
                        {
                            <img src="@Url.Content(BatteryShop.WebApp.Infrastructure.ImagePathHelper.GetProfileUrl(Model.ProfileImage))" alt="Profile" class="profile-avatar-preview" id="avatarImg" />
                        }
                        else
                        {
                            var nameParts = (Model.OwnerName ?? "?").Split(new[] { ' ' }, System.StringSplitOptions.RemoveEmptyEntries);
                            var initials = nameParts.Length == 0 ? "?" : string.Join("", System.Linq.Enumerable.Take(System.Linq.Enumerable.Select(nameParts, p => char.ToUpper(p[0])), 2));
                            <div class="profile-avatar-fallback" id="avatarImg">@initials</div>
                        }
                    </div>
                    <div class="profile-avatar-actions">
                        <label for="profileImageFile">
                            <i class="bi bi-camera"></i> Change Photo
                        </label>
                        <input type="file" id="profileImageFile" name="profileImageFile" accept="image/*" style="display:none;" />
                        <button type="button" class="btn-remove-photo @(string.IsNullOrEmpty(Model.ProfileImage) ? "hidden" : "")" id="removePhotoBtn">
                            <i class="bi bi-trash"></i> Remove
                        </button>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Full Name</label>
                        @Html.TextBoxFor(m => m.OwnerName, new { @class = "form-control", placeholder = "Enter your name" })
                        @Html.ValidationMessageFor(m => m.OwnerName, "", new { @class = "text-danger", style = "font-size:0.8rem;" })
                    </div>
                    <div class="form-group">
                        <label class="form-label">Phone</label>
                        @Html.TextBoxFor(m => m.OwnerPhone, new { @class = "form-control", placeholder = "Phone number" })
                        @Html.ValidationMessageFor(m => m.OwnerPhone, "", new { @class = "text-danger", style = "font-size:0.8rem;" })
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Email</label>
                    @Html.TextBoxFor(m => m.OwnerEmail, new { @class = "form-control", placeholder = "Email address" })
                    @Html.ValidationMessageFor(m => m.OwnerEmail, "", new { @class = "text-danger", style = "font-size:0.8rem;" })
                </div>

                <div class="profile-actions">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-cancel">Cancel</a>
                    <button type="submit" class="btn btn-save">Save Changes</button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script src="~/PageScripts/ProfileScript.js"></script>
}
