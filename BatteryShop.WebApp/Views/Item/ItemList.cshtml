@model BatteryShop.DataAccess.ViewModels.ItemViewModel
@{
    ViewBag.Title = "Inventory";
}

<form method="POST" id="searchForm">

    @Html.HiddenFor(m => m.PageNumber, new { id = "PageNumber" })

    <div class="filters-container">
        <div class="filter-group">
            @Html.LabelFor(m => m.PageSize, "Page Size")
            @Html.DropDownListFor( m => m.PageSize,new SelectList(Model.PageSizeList),"--Select--",new { id = "PageSizeList", @class = "form-control" }
        )
        </div>

        <div class="filter-group">
            @Html.LabelFor(m => m.SerialNumber, "Serial Number")
            @Html.TextBoxFor(m => m.SerialNumber, new { @class = "form-control", placeholder = "Enter serial number" })
        </div>

        <div class="filter-group">
            @Html.LabelFor(m => m.BrandId, "Brand")
            @Html.DropDownListFor(
            m => m.BrandId,
            new SelectList(Model.BrandList, "BrandId", "BrandName"),
            "--Select--",
            new { id = "BrandSelect", @class = "form-control" }
        )
        </div>

        <div class="filter-actions">
            <button type="button" id="searchBtn" class="btn btn-primary">Search</button>
            <button type="reset" id="resetbutton" class="btn btn-secondary">Reset</button>
            <button type="button" id="addItemBtn" class="btn btn-success">Add Item</button>
        </div>
    </div>
    <div class="results-wrapper">
        <div id="resultContainer"></div>
    </div>

    <div class="pagination-footer">
        <span id="PageItems" class="items-info"></span>
        <div class="pagination-buttons">
            <button type="button" id="prevButton" class="btn btn-sm btn-secondary">Previous</button>
            <span id="buttonlist" class="page-buttons"></span>
            <button type="button" id="nextButton" class="btn btn-sm btn-secondary">Next</button>
        </div>
    </div>
</form>


<script>
    var _modelBrandList = @Html.Raw(Json.Encode(Model.BrandList)) || [];
    var _modelTypeList = @Html.Raw(Json.Encode(Model.TypeList)) || [];
</script>

<!-- Update Offcanvas -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="updateOffcanvas">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">
            <i class="bi bi-pencil-square"></i> Update Item
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <div class="offcanvas-spinner" id="updSpinner">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p>Loading item data...</p>
        </div>
        <div id="updFormContainer" style="display:none;">
            <form id="updateForm">
                <div class="batch-card">
                    <div class="batch-filters">
                        <div class="filter-group">
                            <label class="form-label">Item ID</label>
                            <input type="text" id="updItemId" class="form-control" readonly />
                        </div>
                        <div class="filter-group">
                            <label class="form-label">Transaction ID</label>
                            <input type="number" id="updTransactionId" class="form-control" />
                        </div>
                    </div>

                    <div class="batch-filters">
                        <div class="filter-group">
                            <label class="form-label">Brand</label>
                            <select id="updBrandId" class="form-control">
                                <option value="">--Select Brand--</option>
                                @foreach (var brand in Model.BrandList)
                                {
                                    <option value="@brand.BrandId">@brand.BrandName</option>
                                }
                            </select>
                        </div>
                        <div class="filter-group">
                            <label class="form-label">Type</label>
                            <select id="updTypeId" class="form-control">
                                <option value="">--Select Type--</option>
                            </select>
                        </div>
                    </div>

                    <div class="batch-filters">
                        <div class="filter-group">
                            <label class="form-label">Serial Number</label>
                            <input type="text" id="updSerialNumber" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="offcanvas-actions">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Update
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="offcanvas">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

    <script src="~/Scripts/ItemListScript.js"></script>