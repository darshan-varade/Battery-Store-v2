@model BatteryShop.DataAccess.ViewModels.ItemUpdateViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Update Item";
}

<div class="item-add-container">
    <div class="item-add-header">
        <h2>Update Item</h2>
        <p class="subtitle">Update item details</p>
    </div>

    <form id="itemUpdateForm">

        <div class="batch-card">

            <div class="batch-filters">

                <div class="filter-group">
                    <label class="form-label">Item ID</label>
                    <input type="text"
                           id="ItemId"
                           class="form-control"
                           value="@Model.ItemId"
                           readonly />
                </div>

                <div class="filter-group">
                    <label class="form-label">Transaction ID</label>
                    <input type="number"
                           id="TransactionId"
                           class="form-control"
                           value="@Model.TransactionId" />
                </div>

            </div>

            <div class="batch-filters">
                <div class="filter-group">
                    <label class="form-label">Brand</label>

                    @Html.DropDownListFor(
                        m => m.BrandId,
                        new SelectList(
                            Model.BrandList,
                            "BrandId",
                            "BrandName",
                            Model.BrandId
                        ),
                        "--Select Brand--",
                        new
                        {
                            id = "BrandId",
                            @class = "form-control"
                        }
                    )

                </div>
                <div class="filter-group">
                    <label class="form-label">Type</label>

                    @Html.DropDownListFor(
                        m => m.TypeId,
                        new SelectList(
                            Model.TypeList,
                            "TypeId",
                            "TypeName",
                            Model.TypeId
                        ),
                        "--Select Type--",
                        new
                        {
                            id = "TypeId",
                            @class = "form-control"
                        }
                    )

                </div>
                

            </div>

            <div class="batch-filters">

                <div class="filter-group">
                    <label class="form-label">Serial Number</label>
                    <input type="text"
                           id="SerialNumber"
                           class="form-control"
                           value="@Model.SerialNumber" />
                </div>

            </div>

        </div>

        <div class="form-actions">

            <button type="submit" class="btn btn-success btn-lg">
                <i class="bi bi-check-circle"></i>
                Update
            </button>

            <a href="@Url.Action("ItemList","Item")"
               id="cancelBtn"
               class="btn btn-secondary btn-lg">
                Cancel
            </a>

        </div>

    </form>

</div>

<script>
    var _urlItemUpdate = '@Url.Action("ItemUpdate", "Item")';
    var _urlItemList = '@Url.Action("ItemList", "Item")';
</script>

<script src="~/Scripts/ItemUpdateScript.js"></script>