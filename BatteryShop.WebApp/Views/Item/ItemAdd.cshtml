@model BatteryShop.DataAccess.ViewModels.ItemViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Add Item";
}

<div class="item-add-container">
    <div class="item-add-header">
        <h2>Add New Items</h2>
        <p class="subtitle">Add items with different brands, types, and serial numbers</p>
    </div>

    <form id="itemAddForm">
        <div class="form-section">
            <div class="form-group">
                <label for="transactionId" class="form-label">Transaction ID *</label>
                <input type="text" id="transactionId" name="transactionId" class="form-control" placeholder="Enter transaction ID" required />
            </div>
        </div>

        <div id="batchesContainer" class="batches-container">
        </div>

        <div class="button-group">
            <button type="button" id="addBatchBtn" class="btn btn-secondary rounded-pill">
                <i class="bi bi-plus-circle"></i>
            </button>
        </div>                                                                      

        <div class="form-actions">
            <button type="submit" class="btn btn-success btn-lg">
                <i class="bi bi-check-circle"></i> Submit
            </button>
            <a href="@Url.Action("ItemList", "Item")" id="cancelBtn" class="btn btn-secondary btn-lg">
                <i class="bi bi-x-circle"></i> Cancel
            </a>
        </div>
    </form>
</div>

<script>
    var _modelBrandList = @Html.Raw(Json.Encode(Model.BrandList)) || [];
    var _modelTypeList = @Html.Raw(Json.Encode(Model.TypeList)) || [];
    var _urlItemAdd = '@Url.Action("ItemAdd", "Item")';
    var _urlItemList = '@Url.Action("ItemList", "Item")';
</script>

<script src="~/PageScripts/ItemAddScript.js"></script>